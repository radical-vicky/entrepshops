{
    "builds": [
        {
            "src": "drinkshop/wsgi.py",
            "use": "@vercel/python",
            "config": { "runtime": "python3.12", "maxLambdaSize": "50mb" }
        },
        {
            "src": "build_files.sh",
            "use": "@vercel/static-build",
            "config": { "distDir": "staticfiles" }
        }
    ],
    "routes": [
        { "src": "/static/(.*)", "dest": "/static/$1" },
        { "src": "/(.*)", "dest": "drinkshop/wsgi.py" }
    ]
}
