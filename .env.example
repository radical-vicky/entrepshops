# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=

# KES flat delivery fee applied to every order
DELIVERY_FEE=150

# KES credited to BOTH the referrer and a new signup who joins via a
# referral link (?ref=CODE). Set to 0 to disable payouts.
REFERRAL_BONUS_KES=50

# Keep True unless your business is legally allowed to sell/deliver alcohol
# online in your jurisdiction.
DISALLOW_ALCOHOL_DELIVERY=True

# --- Database ---
# Leave unset for local dev — SQLite is used automatically. Required for
# Vercel or any serverless/ephemeral-filesystem host, since SQLite can't
# persist there. Get one free from Vercel Postgres, Neon, or Supabase.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=
DATABASE_SSL_REQUIRE=False

# --- Cloudinary (image storage — https://cloudinary.com/console) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Sign-In (via django-allauth) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ACCOUNT_EMAIL_VERIFICATION=optional

# --- Email (password reset, optional signup verification) ---
# Leave EMAIL_HOST blank to print emails to the console instead of sending
# them — fine for local dev. Fill these in for real email in production.
# Example values for Gmail (use an App Password, not your normal password):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-char-app-password
#   EMAIL_USE_TLS=True
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DrinkShop <noreply@drinkshop.local>

# --- M-Pesa Daraja API (https://developer.safaricom.co.ke) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
# Must be a public HTTPS URL Safaricom can reach (e.g. via ngrok in dev)
MPESA_CALLBACK_URL=https://your-domain.com/payments/mpesa/callback/
